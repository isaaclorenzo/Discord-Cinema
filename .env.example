# Variables del servidor (solo las usa el relay /api/relay; nunca llegan al navegador).

# Token obligatorio para usar el relay en producción. Genera uno largo y aleatorio,
# por ejemplo: openssl rand -hex 32. Luego escríbelo en Ajustes → Seguridad de la app.
HARNESS_ACCESS_TOKEN=

# Opcional: limita el relay a estos dominios (separados por comas).
# Vacío = cualquier dominio público (las IPs privadas siempre se bloquean).
RELAY_ALLOWED_HOSTS=
